	"scripts": {
		"dev": "node ../scripts/build-media-wasm.mjs && node ../scripts/build-readers.mjs && vite",
		"build": "node ../scripts/build-media-wasm.mjs && node ../scripts/build-readers.mjs && vite build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@kenjiuno/msgreader": "1.29.0",
