		"docx-preview": "0.4.1",
		"dompurify": "3.4.17",
		"exifr": "7.1.3",
		"fflate": "0.8.3",
		"hash-wasm": "^4.12.0",
		"libheif-js": "1.23.5",
		"lit": "^3.3.0",
		"pdfjs-dist": "6.4.299",
		"postal-mime": "4.1.4",
		"pptx-preview": "1.0.7",
		"utif2": "4.1.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
