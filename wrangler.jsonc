// Gorani: a zero-trust, end-to-end encrypted family NAS.
//
// Everything is sealed in the browser (or the native clients) before the
// server sees a byte; the Worker stores ciphertext, wrapped keys and just
// enough readable structure (sizes, times, folder shape) to sync and browse.
// This file is the deployment recipe: what runs, where the code lives, and
// which Cloudflare bindings it needs. See docs/ARCHITECTURE.md for the
// guided tour and docs/COURSE.md for the lesson index.
{
	// The JSON schema so editors validate and autocomplete this file.
	"$schema": "node_modules/wrangler/config-schema.json",

	// The Worker's name on Cloudflare. The deployed URL is https://<name>.<account>.workers.dev
	// unless a custom domain/route is attached (recommended; passkeys and
	// Cloudflare Access are registered per domain).
	"name": "gorani",

	// The Rust worker builds with worker-build into a JS shim + a wasm module.
	// wrangler runs `build.command` automatically on deploy/dev, then uploads
	// these paths as the Worker's entry module.
	"main": "worker/build/worker/shim.mjs",
	"compatibility_date": "2026-09-01",

	// Build the Rust worker. `worker-build` compiles src/lib.rs to
	// wasm32-unknown-unknown, runs wasm-bindgen and emits build/worker/.
	// PATH: rustup installs cargo into ~/.cargo/bin, which a login shell has
	// but wrangler's build shell may not — make it explicit.
	"build": {
		"command": "cd worker && export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo install -q worker-build && worker-build --release"
	},

	// The web app is a static Lit SPA built into web/dist and served by the
	// platform's asset server (fast, and outside the Worker's CPU budget).
	// API and public share paths run this Worker first; everything else is a
	// static file, with unknown paths handed index.html (a single-page app).
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/s/*"]
	},

	// Non-secret configuration. Replace with your own values at deploy time.
	// Secrets (S3_ACCESS_KEY_ID, S3_SECRET_KEY) are NOT here: `wrangler secret put`.
	"vars": {
		// The public URL the app is served from (used for CORS, share links).
		"PUBLIC_ORIGIN": "https://gorani.example.com",
		// Any S3-compatible endpoint, reachable over HTTPS from the internet.
		// MinIO: your reverse-proxied (TLS) address; region can be any string MinIO accepts.
		"S3_ENDPOINT": "https://minio.example.com",
		"S3_REGION": "us-east-1",
		"S3_BUCKET": "gorani",

		// ── Object caching (worker/src/cache.rs) ──────────────────────────
		// (These two lived at the TOP level of this file until commit 23,
		// where wrangler ignores unknown keys with only a warning — so they
		// never reached the Worker and the code ran on its built-in
		// defaults. Configuration that silently doesn't apply is a bug.)
		// Whole-object and frame-span entries of encrypted blobs, keyed by
		// STORAGE span (shared by every member and share link — ciphertext is
		// recipient-independent). Object keys are version-unique, so entries
		// are immutable; a month of TTL needs no invalidation, and deleted
		// content's stale entries open to nothing (crypto-shredding).
		"CACHE_MAX_OBJECT_MB": "256",
		"CACHE_TTL_DAYS": "30"
	},

	// ── Storage priority: Cloudflare R2 ──────────────────────────────────
	// Uncomment this block to bind an R2 bucket, and the Worker routes EVERY
	// object operation through it instead of the signed S3 transport: an
	// in-process call — no SigV4 signing, no HTTP hop, no egress fees (the
	// Worker and R2 then live in the same runtime). Leave it out to store
	// objects in any S3-compatible endpoint (MinIO &c.) — the adapter above
	// is the generic path. The binding wins whenever it exists; see
	// worker/src/s3.rs (`r2_bucket`) and docs/PRODUCTION.md › Storage.
	// "r2_buckets": [
	// 	{ "binding": "R2BUCKET", "bucket_name": "gorani" }
	// ],

	// One SQLite-backed Durable Object per concern: the family registry
	// (instance `family`) and one per member (instance `member:<id>`). The
	// migration uses `new_sqlite_classes` — every DO gets its own SQLite
	// database; see worker/src/family.rs and worker/src/member.rs.
	"durable_objects": {
		"bindings": [
			{ "name": "FAMILY", "class_name": "GoraniFamilyDO" },
			{ "name": "MEMBER", "class_name": "GoraniMemberDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["GoraniFamilyDO", "GoraniMemberDO"] }
	],

	// Rate limits (commit 25, docs/SECURITY-REVIEW.md › O13) — the Workers
	// rate-limiting binding: per caller (CF-Connecting-IP) and target, per
	// minute. The public share routes are the only ones reachable without
	// signing in; device-token checks are behind Access but each is a DO
	// round trip. Generous for people, tight for scripts. (namespace_id: any
	// account-unique integer; the WAF rules in docs/PRODUCTION.md add a
	// second, edge-wide layer.)
	"ratelimits": [
		{ "name": "SHARE_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
		{ "name": "DEVICE_LIMITER", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } }
	],

	"observability": {
		"enabled": true
	},

	// The nightly maintenance pass (worker/src/cron.rs → member DOs): retention
	// housekeeping on the deployment defaults and backup-manifest pruning,
	// 03:17 UTC — a deliberately odd minute so the family's own scheduled
	// things (NAS snapshots &c.) don't all fire on the same instant.
	"triggers": {
		"crons": ["17 3 * * *"]
	}
}